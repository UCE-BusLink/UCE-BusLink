

# -- Backend ------------------------------------------------------------------
APP_NAME=uce-buslink-backend
SERVER_PORT=8080

# -- Base de datos (PostgreSQL) -----------------------------------------------

DB_URL=jdbc:postgresql://localhost:5432/uce_buslink_db
DB_USERNAME=buslink_user
DB_PASSWORD=change_me
DB_DRIVER=org.postgresql.Driver


JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
HIBERNATE_DDL_AUTO=validate
JPA_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true


REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -- Flyway -------------------------------------------------------------------
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_VALIDATE=true
FLYWAY_BASELINE=true

# -- JWT ----------------------------------------------------------------------
JWT_SECRET=change_me_use_a_random_string_of_at_least_64_characters_long
JWT_EXPIRATION_MS=900000

# -- Google OAuth2 + Maps -----------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -- Microsoft OAuth2 ---------------------------------------------------------
MICROSOFT_TENANT_ID=your-microsoft-tenant-id

# -- Clerk --------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_...


# -- Contenedor PostgreSQL ----------------------------------------------------
POSTGRES_USER=buslink_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=uce_buslink_db



# -- Tags de imagen Docker ----------------------------------------------------
BACKEND_TAG=latest
FRONTEND_TAG=latest
STORYBOOK_TAG=latest

# -- Spring profile -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev



VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id
VITE_MICROSOFT_TENANT_ID=your-microsoft-tenant-id
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
