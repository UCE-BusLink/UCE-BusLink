# =============================================================================
# UCE-BUSLINK FRONTEND WEB — Dockerfile (Production Ready)
# =============================================================================

# -----------------------------------------------------------------------------
# STAGE 1: BUILD
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder

# Variables que Vite embebe en el bundle al compilar
ARG VITE_API_URL=/api
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_MICROSOFT_CLIENT_ID
ARG VITE_MICROSOFT_TENANT_ID
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_FIREBASE_VAPID_KEY

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_MICROSOFT_CLIENT_ID=$VITE_MICROSOFT_CLIENT_ID
ENV VITE_MICROSOFT_TENANT_ID=$VITE_MICROSOFT_TENANT_ID
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_FIREBASE_VAPID_KEY=$VITE_FIREBASE_VAPID_KEY

WORKDIR /app

COPY uce-buslink-frontend/uce-buslink-web/package*.json ./

RUN npm install --ignore-scripts

COPY uce-buslink-frontend/uce-buslink-web/ ./

RUN npm run build

# -----------------------------------------------------------------------------
# STAGE 2: RUNTIME
# -----------------------------------------------------------------------------
FROM --platform=$TARGETPLATFORM nginx:1.27-alpine AS runtime

# Patch Alpine CVEs; openssl/gettext for cert bootstrap + envsubst
RUN apk upgrade --no-cache && \
    apk add --no-cache openssl gettext

ARG APP_VERSION=0.0.0
LABEL maintainer="UCE-BusLink Team"
LABEL app="uce-buslink-frontend-web"
LABEL version="${APP_VERSION}"

RUN rm /etc/nginx/conf.d/default.conf

# Point logs straight to stdout/stderr instead of the symlinked files
RUN sed -i \
    -e 's#/var/log/nginx/error.log#/dev/stderr#' \
    -e 's#/var/log/nginx/access.log#/dev/stdout#' \
    /etc/nginx/nginx.conf

# entrypoint.sh picks TLS vs HTTP-only template based on ENABLE_HTTPS
COPY docker/nginx-https.conf.template /etc/nginx/templates/nginx-https.conf.template
COPY docker/nginx-http.conf.template /etc/nginx/templates/nginx-http.conf.template
COPY docker/nginx-entrypoint.sh /entrypoint.sh

COPY --from=builder /app/dist /usr/share/nginx/html

RUN chmod +x /entrypoint.sh && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

# Master runs as root for cert setup; workers drop to "nginx" via nginx.conf

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/healthz || exit 1

ENTRYPOINT ["/entrypoint.sh"]
