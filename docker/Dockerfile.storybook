# =============================================================================
# UCE-BUSLINK STORYBOOK — Dockerfile (static build, served by Nginx)
# =============================================================================

# -----------------------------------------------------------------------------
# STAGE 1: BUILD
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder

WORKDIR /app

COPY uce-buslink-frontend/uce-buslink-web/package*.json ./

RUN npm install --ignore-scripts

COPY uce-buslink-frontend/uce-buslink-web/ ./

RUN npm run build-storybook

# -----------------------------------------------------------------------------
# STAGE 2: RUNTIME
# -----------------------------------------------------------------------------
FROM --platform=$TARGETPLATFORM nginx:1.27-alpine AS runtime

RUN apk upgrade --no-cache

LABEL maintainer="UCE-BusLink Team"
LABEL app="uce-buslink-storybook"

RUN rm /etc/nginx/conf.d/default.conf

COPY docker/nginx.storybook.conf /etc/nginx/conf.d/app.conf

COPY --from=builder /app/storybook-static /usr/share/nginx/html

RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80 || exit 1

CMD ["nginx", "-g", "daemon off;"]
