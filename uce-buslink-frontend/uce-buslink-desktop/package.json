{
  "name": "uce-buslink-desktop",
  "private": true,
  "version": "1.1.0",
  "description": "UCE Bus-Link — Aplicación de escritorio para administradores",
  "homepage": "https://github.com/UCE-BusLink/UCE-BusLink",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "david",
    "email": "ldalomoto@uce.edu.ec"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "lint": "eslint . || true",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:qa": "npm run build -- --mode qa && electron-builder --config.productName=\"QA UCE BusLink Admin\" --config.appId=ec.uce.buslink.desktop.qa",
    "dist:localhost": "npm run build -- --mode localhost && electron-builder --config.productName=\"LocalHost UCE BusLink Admin\" --config.appId=ec.uce.buslink.desktop.localhost",
    "dist:all": "npm run dist && npm run dist:qa && npm run dist:localhost"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.8",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.2",
    "dayjs": "^1.11.21",
    "firebase": "^12.15.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "8.0.16",
    "wait-on": "^9.0.1"
  },
  "overrides": {
    "rolldown": "1.0.3",
    "@tailwindcss/oxide": "4.3.1"
  },
  "build": {
    "appId": "ec.uce.buslink.desktop",
    "productName": "UCE BusLink Admin",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/favicon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/favicon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}